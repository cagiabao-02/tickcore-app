# Chỉ dùng local development. Thay các giá trị trước khi chạy.
MYSQL_ROOT_PASSWORD=change_this_local_root_password
MYSQL_DATABASE=cinema_booking
MYSQL_USER=cinema_app
MYSQL_PASSWORD=change_this_local_app_password
MYSQL_PORT=3306

DB_URL=jdbc:mysql://localhost:3306/cinema_booking?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=cinema_app
DB_PASSWORD=change_this_local_app_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_strong_password_12_chars_minimum
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000
